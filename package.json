{
  "name": "her-text",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "onnxruntime-node"
    ]
  },
  "scripts": {
    "dev": "turbo run dev",
    "desktop:dev": "cd apps/desktop && pnpm run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "start": "cd apps/desktop && pnpm run start",
    "history:clear": "bash ./scripts/clear-history.sh",
    "download:models": "bash ./scripts/download-models.sh",
    "postinstall": "bash ./scripts/download-models.sh || true"
  },
  "devDependencies": {
    "turbo": "^2.9.7",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}

{
  "name": "@noema/desktop",
  "version": "0.0.5",
  "license": "AGPL-3.0-only",
  "description": "Noema Desktop - AI Companion Application",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/ensure-dev-port.mjs && concurrently \"pnpm run dev:main\" \"pnpm run dev:renderer\"",
    "dev:main": "cross-env NODE_ENV=development tsc -p tsconfig.main.json && node ./scripts/copy-preload.mjs && electron .",
    "dev:renderer": "vite",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json && node ./scripts/copy-preload.mjs",
    "build:renderer": "vite build",
    "start": "pnpm run build && cross-env NODE_ENV=production electron .",
    "package": "electron-builder",
    "install:mac:local": "node ./scripts/install-mac-local.mjs"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
    "@floating-ui/dom": "^1.7.6",
    "@lobehub/icons-static-svg": "^1.90.0",
    "@noema/sdk": "workspace:*",
    "chokidar": "^3.5.3",
    "dotenv": "^17.4.2",
    "fuse.js": "^7.4.2",
    "global-agent": "^3.0.0",
    "gsap": "^3.15.0",
    "litegraph.js": "^0.7.18",
    "lucide": "^1.17.0",
    "onnxruntime-node": "^1.24.3",
    "openai": "^4.28.0",
    "split-grid": "^1.0.11",
    "three": "^0.184.0",
    "ws": "^8.18.0",
    "yaml": "^2.3.4",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.12",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.4.0",
    "vite": "^6.4.2"
  },
  "build": {
    "appId": "com.xhacker.noema",
    "productName": "Noema",
    "electronVersion": "28.3.3",
    "icon": "resources/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/icon.png",
      "package.json",
      "!dist/**/*.d.ts",
      "!dist/**/*.d.ts.map",
      "!node_modules/@noema/sdk/src/**",
      "!node_modules/@noema/sdk/jest.config.cjs",
      "!node_modules/@noema/sdk/tsconfig.json",
      "!node_modules/@noema/sdk/**/*.d.ts",
      "!node_modules/@noema/sdk/**/*.d.ts.map"
    ],
    "extraResources": [
      {
        "from": "../../role",
        "to": "role"
      },
      {
        "from": "../../plugins/local/fish-s2-emotion",
        "to": "plugins/local/fish-s2-emotion"
      }
    ],
    "afterPack": "scripts/prune-package.cjs",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png"
    }
  }
}

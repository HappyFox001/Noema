{
  "name": "@noema/desktop",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "Noema Desktop - AI Companion Application",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/ensure-dev-port.mjs && concurrently \"pnpm run dev:main\" \"pnpm run dev:renderer\"",
    "dev:main": "cross-env NODE_ENV=development tsc -p tsconfig.main.json && node ./scripts/copy-preload.mjs && electron .",
    "dev:renderer": "vite",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json && node ./scripts/copy-preload.mjs",
    "build:renderer": "vite build",
    "start": "pnpm run build && cross-env NODE_ENV=production electron .",
    "package": "electron-builder"
  },
  "dependencies": {
    "@noema/sdk": "workspace:*",
    "@lobehub/icons-static-svg": "^1.90.0",
    "chokidar": "^3.5.3",
    "dotenv": "^17.4.2",
    "global-agent": "^3.0.0",
    "onnxruntime-node": "^1.24.3",
    "openai": "^4.28.0",
    "three": "^0.184.0",
    "ws": "^8.18.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.12",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.4.0",
    "vite": "^6.4.2"
  },
  "build": {
    "appId": "com.xhacker.noema",
    "productName": "Noema",
    "icon": "resources/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png"
    }
  }
}

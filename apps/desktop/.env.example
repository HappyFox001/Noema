# ========================================
# Her-Text 配置文件模板
# ========================================

# ========== LLM 配置（必需）==========

# LLM 模型配置
# LLM_1_MODEL: 模型名称（也是 API 参数，如 deepseek-chat, gpt-4）
# LLM_1_API_KEY: API 密钥
# LLM_1_BASE_URL: API 地址
LLM_1_MODEL=deepseek-chat
LLM_1_API_KEY=your_api_key_here
LLM_1_BASE_URL=https://api.deepseek.com

# 可以添加更多 LLM 模型:
# LLM_2_MODEL=gpt-4
# LLM_2_API_KEY=sk-xxx
# LLM_2_BASE_URL=https://api.openai.com/v1

# 激活的 LLM 编号（默认 1）
LLM_ACTIVE=1

# ========== 语音合成 TTS 配置（可选）==========

# TTS 模型配置
# TTS_1_PROVIDER: 服务商（目前支持: fish）
# TTS_1_MODEL: 模型名称（如 s2-pro）
# TTS_1_API_KEY: API 密钥（获取: https://fish.audio/）
# TTS_1_VOICE_ID: 音色 ID（浏览音色: https://fish.audio/voices）
TTS_1_PROVIDER=fish
TTS_1_MODEL=s2-pro
TTS_1_API_KEY=
TTS_1_VOICE_ID=

# 激活的 TTS 编号（默认 1）
TTS_ACTIVE=1

# ========== 语音识别 ASR 配置（可选）==========

# ASR 模型配置
# ASR_1_PROVIDER: 服务商（目前支持: qwen）
# ASR_1_MODEL: 模型名称（如 realtime）
# ASR_1_API_KEY: API 密钥（获取: https://dashscope.console.aliyun.com/）
ASR_1_PROVIDER=qwen
ASR_1_MODEL=realtime
ASR_1_API_KEY=

# 激活的 ASR 编号（默认 1）
ASR_ACTIVE=1

# ========== 代理配置（可选）==========

# HTTP/HTTPS 代理
# 格式: http://host:port 或 http://user:pass@host:port
# 留空 = 不使用代理
HTTPS_PROXY=

# 不走代理的地址（可选）
# NO_PROXY=localhost,127.0.0.1,*.local

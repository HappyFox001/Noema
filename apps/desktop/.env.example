# ========================================
# Her-Text 配置文件
# ========================================

# ========== LLM 配置 ==========

# LLM API Key
VITE_LLM_API_KEY=your_api_key_here

# LLM Model
VITE_LLM_MODEL=gpt-4o-mini
VITE_LLM_BASE_URL=

# ========== 语音识别 (STT) ==========

# Qwen Omni STT API Key
# 获取: https://dashscope.console.aliyun.com/
VITE_QWEN_API_KEY=your_qwen_api_key_here

# ========== 语音合成 (TTS) ==========

# Fish Audio TTS API Key
# 获取: https://fish.audio/
VITE_FISH_API_KEY=your_fish_api_key_here

# Fish Audio Voice ID (可选，用于指定音色)
# 浏览音色: https://fish.audio/voices
# 留空则使用默认音色
VITE_FISH_VOICE_ID=022feade5cc0492286a854cc87aff955

# ========================================
# Her-Text 配置文件模板
# ========================================

# ========== LLM 配置（必需）==========

# LLM API Key
# Deepseek: https://platform.deepseek.com/api_keys
# OpenAI: https://platform.openai.com/api-keys
# 其他兼容 OpenAI API 的服务也可以使用
LLM_API_KEY=your_api_key_here

# LLM Model
# 示例: deepseek-chat, gpt-4, gpt-3.5-turbo
LLM_MODEL=deepseek-chat

# LLM Base URL
# Deepseek: https://api.deepseek.com
# OpenAI: https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com

# ========== 语音合成 (TTS)（可选）==========

# Fish Audio TTS API Key
# 获取: https://fish.audio/
# 如果不需要语音功能，可以留空
FISH_API_KEY=

# Fish Audio Voice ID
# 浏览音色: https://fish.audio/voices
# 留空则使用默认音色
FISH_VOICE_ID=

# Fish Audio Model
# 可选: s2-pro, s2-standard
FISH_MODEL=s2-pro

# ========== 语音识别 (STT)（可选）==========

# Qwen Omni STT API Key
# 获取: https://dashscope.console.aliyun.com/
# 如果不需要语音输入功能，可以留空
QWEN_API_KEY=

# ========== 代理配置（可选）==========

# HTTP/HTTPS 代理
# 如果需要通过代理访问 API，设置此项
# 支持的格式: http://host:port 或 http://user:pass@host:port
# 留空或不设置则不使用代理
# 注意: HTTPS_PROXY 和 HTTP_PROXY 都会被读取，设置其中一个即可
HTTPS_PROXY=
# HTTP_PROXY=

# 不走代理的地址（可选）
# 多个地址用逗号分隔，例如: localhost,127.0.0.1,*.local
# NO_PROXY=

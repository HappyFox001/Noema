{
  "id": "live2d-avatar",
  "name": "Live2D Avatar",
  "description": "Loads a configurable Live2D Cubism avatar in the main view and maps Her-Text state updates to motions, expressions, pose, and lip sync.",
  "version": "0.1.0",
  "type": "sdk-plugin",
  "main": "index.mjs",
  "assets": "assets",
  "enabled": true,
  "permissions": [
    "network"
  ],
  "config": {
    "modelUrl": "",
    "pixiUrl": "https://cdn.jsdelivr.net/npm/pixi.js@6.5.10/dist/browser/pixi.min.js",
    "cubismCoreUrl": "https://cdn.jsdelivr.net/npm/live2dcubismcore@1.0.2/live2dcubismcore.min.js",
    "live2dDisplayUrl": "https://cdn.jsdelivr.net/npm/pixi-live2d-display@0.4.0/dist/cubism4.min.js",
    "scale": 0.24,
    "offsetX": 0,
    "offsetY": 0,
    "lipSyncGain": 1.8,
    "idleMotion": "Idle",
    "listeningMotion": "TapBody",
    "thinkingMotion": "Thinking",
    "speakingMotion": "TapBody",
    "taskMotion": "FlickHead",
    "errorMotion": "Shake"
  },
  "configSchema": [
    {
      "key": "modelUrl",
      "label": "Model URL",
      "description": "Absolute URL or file URL for a Cubism .model3.json file. Leave empty to show the setup placeholder.",
      "type": "string",
      "default": "",
      "placeholder": "file:///.../model.model3.json"
    },
    {
      "key": "scale",
      "label": "Scale",
      "description": "Base model scale.",
      "type": "number",
      "default": 0.24,
      "min": 0.05,
      "max": 1.5,
      "step": 0.01
    },
    {
      "key": "offsetX",
      "label": "Offset X",
      "description": "Horizontal model offset in CSS pixels.",
      "type": "number",
      "default": 0,
      "min": -600,
      "max": 600,
      "step": 5
    },
    {
      "key": "offsetY",
      "label": "Offset Y",
      "description": "Vertical model offset in CSS pixels.",
      "type": "number",
      "default": 0,
      "min": -600,
      "max": 600,
      "step": 5
    },
    {
      "key": "lipSyncGain",
      "label": "Lip sync gain",
      "description": "Multiplier applied to Her-Text output energy before writing mouth parameters.",
      "type": "number",
      "default": 1.8,
      "min": 0,
      "max": 8,
      "step": 0.1
    }
  ],
  "uiSurfaces": [
    {
      "id": "live2d-avatar-main",
      "slot": "main-view",
      "mode": "replace",
      "entry": "ui/index.html",
      "title": "Live2D Avatar"
    }
  ]
}

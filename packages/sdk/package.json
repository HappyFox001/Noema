{
  "name": "@noema/sdk",
  "version": "0.0.5",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./character-workflow": {
      "types": "./dist/character-workflow/index.d.ts",
      "import": "./dist/character-workflow/index.js",
      "default": "./dist/character-workflow/index.js"
    },
    "./chat/conversation-runtime": {
      "types": "./dist/chat/conversation-runtime.d.ts",
      "import": "./dist/chat/conversation-runtime.js",
      "default": "./dist/chat/conversation-runtime.js"
    },
    "./chat/model-list": {
      "types": "./dist/chat/model-list.d.ts",
      "import": "./dist/chat/model-list.js",
      "default": "./dist/chat/model-list.js"
    },
    "./image": {
      "types": "./dist/image/index.d.ts",
      "import": "./dist/image/index.js",
      "default": "./dist/image/index.js"
    },
    "./image/catalog": {
      "types": "./dist/image/catalog.d.ts",
      "import": "./dist/image/catalog.js",
      "default": "./dist/image/catalog.js"
    },
    "./config/personality-loader": {
      "types": "./dist/config/personality-loader.d.ts",
      "import": "./dist/config/personality-loader.js",
      "default": "./dist/config/personality-loader.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "dependencies": {
    "fft.js": "^4.0.4",
    "fish-audio": "^0.1.0",
    "openai": "^4.28.0",
    "proxy-agent": "^6.5.0",
    "undici": "^6.22.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "typescript": "^5.4.0"
  }
}
